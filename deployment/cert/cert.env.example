# ArbiCore X — VPS certification env EXAMPLE (NO SECRETS committed).
#
# Copy to `deployment/cert/cert.env` ON THE VPS ONLY and fill with the operator's
# READ-ONLY RPC endpoints. `cert.env` is git-ignored and must never be committed,
# logged, or pasted into chat. Real values live only in the VPS cert environment.
#
# Six operator RPCs (comma-separate multiple endpoints per chain to test failover).
# CONTRACT: each ARBICORE_RPC_URL_<CHAIN> below is the SINGLE canonical input per
# chain. At certification/runtime init it is deterministically mirrored into the
# provider-registry key PROVIDER_RPC_URL_<CHAIN> (secret-safe, per-chain, NO Base
# leakage), so ONE endpoint per chain satisfies BOTH the chain-scoped RPC/quote
# seam AND the economic all-in-cost gate. You do NOT need to also set
# PROVIDER_RPC_URL[S]_<CHAIN> — but if you do, that explicit value WINS and is
# never overwritten. A chain left blank stays fail-closed (NOT_CONFIGURED); no
# public/default endpoint is ever treated as operator evidence.
ARBICORE_RPC_URL_BASE=
ARBICORE_RPC_URL_ETHEREUM=
ARBICORE_RPC_URL_ARBITRUM=
ARBICORE_RPC_URL_OPTIMISM=
ARBICORE_RPC_URL_POLYGON=
ARBICORE_RPC_URL_BNB=

# Deployed executor/receiver address for the non-production target chain (84532).
ARBICORE_EXECUTOR_ADDRESS_BASE=

# H05 exact-size sizer prerequisites (enable ONLY when a trustworthy operator
# price feed + borrow_sizer are wired; otherwise leave false ⇒ fail-closed).
ARBICORE_PRICE_FEED_ENABLED=false
ARBICORE_BORROW_SIZER_ENABLED=false

# H09 exact candidate-bound simulation method (leave blank ⇒ BLOCKED). Set to an
# exact method ONLY when a real fork/state-override simulator is available:
#   atomic_exact | atomic_state_override | fork_exact | exact_call
ARBICORE_SIM_METHOD=

# Phase-B receiver target chain (non-production).
ARBICORE_CERT_RECEIVER_CHAIN=84532

# Optional provenance for the report (no secret).
ARBICORE_CERT_IMAGE=
GITSHA=
