# ArbiCore X — VPS certification RPC env template (NO SECRETS committed).
#
# Copy to `deployment/cert/cert.env` ON THE VPS ONLY and fill with the operator's
# READ-ONLY RPC endpoints. `cert.env` is git-ignored and must never be committed,
# logged, or pasted into chat.
#
# RPC CONTRACT (one endpoint per chain satisfies BOTH seams):
#   * ARBICORE_RPC_URL_<CHAIN> is the SINGLE canonical operator input per chain.
#     At certification/runtime init it is deterministically mirrored (secret-safe,
#     per-chain, NO Base leakage) into the provider-registry key
#     PROVIDER_RPC_URL_<CHAIN>, so it satisfies BOTH the chain-scoped RPC/quote
#     seam AND the economic all-in-cost gate. Comma-separate for failover.
#   * PROVIDER_RPC_URL[S]_<CHAIN> is an OPTIONAL explicit override. If you set it,
#     that value WINS and is never overwritten by the sync. Leave blank otherwise.
#   * A chain left blank stays fail-closed (NOT_CONFIGURED). No public/default
#     endpoint is ever treated as operator evidence.

# --- Canonical per-chain operator RPCs (fill these) ---
ARBICORE_RPC_URL_BASE=
ARBICORE_RPC_URL_ETHEREUM=
ARBICORE_RPC_URL_ARBITRUM=
ARBICORE_RPC_URL_OPTIMISM=
ARBICORE_RPC_URL_POLYGON=
ARBICORE_RPC_URL_BNB=

# --- Optional explicit provider-registry overrides (leave blank to auto-sync) ---
PROVIDER_RPC_URLS_BASE=
PROVIDER_RPC_URLS_ETHEREUM=
PROVIDER_RPC_URLS_ARBITRUM=
PROVIDER_RPC_URLS_OPTIMISM=
PROVIDER_RPC_URLS_POLYGON=
PROVIDER_RPC_URLS_BNB=

# Deployed executor/receiver address for the non-production target chain (84532).
ARBICORE_EXECUTOR_ADDRESS_BASE=

# H05 exact-size sizer prerequisites (leave false ⇒ fail-closed).
ARBICORE_PRICE_FEED_ENABLED=false
ARBICORE_BORROW_SIZER_ENABLED=false

# H09 exact candidate-bound simulation method (blank ⇒ BLOCKED).
ARBICORE_SIM_METHOD=

# Phase-B receiver target chain (non-production).
ARBICORE_CERT_RECEIVER_CHAIN=84532

# Optional provenance for the report (no secret).
ARBICORE_CERT_IMAGE=
GITSHA=
