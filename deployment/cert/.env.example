# ArbiCore X v2 — SIX-CHAIN OPERATOR RPC CONFIGURATION (certification/runtime)
# =============================================================================
# CANONICAL non-production certification configuration mechanism.
#
# HOW TO USE ON THE VPS (values NEVER committed to Git):
#   1. Copy this template to a sibling file that git ignores:
#        cp deployment/cert/.env.example deployment/cert/.env
#   2. Fill in the REAL operator/archive RPC URLs in deployment/cert/.env.
#   3. Inject into the certification process WITHOUT printing values, e.g.:
#        docker run --env-file deployment/cert/.env  <cert-image>  ...
#      or, for a local run:
#        set -a; . deployment/cert/.env; set +a
#        python /app/scripts/vps_multichain_preflight.py
#
# SECURITY / SAFETY CONTRACT:
#   * deployment/cert/.env (the real values) is git-ignored — see .gitignore.
#   * Only this *.example (names + comments, NO values) is committed.
#   * FAIL-CLOSED: a chain with no operator RPC is NOT operator-authoritative.
#     There is NO fallback from a missing operator RPC to a public endpoint, and
#     NO cross-chain leakage (the base-only ARBICORE_RPC_URL alias never applies
#     to another chain).
#   * A chain is only "RPC-verified" after a real probe of ITS configured
#     endpoint — never from configuration presence alone.
#   * This file configures RPC ONLY. Signing / broadcast / auto-execution /
#     Full-Live / Limited-Live / withdrawals stay OFF and are not set here.
#
# Do NOT assume public RPCs are operator-authoritative. Do NOT commit real URLs.
# =============================================================================

# --- ECONOMIC / PROVIDER RPC (backs the all-in-cost / provider registry gate) ---
# Consumed by provider_registry_rpc_configured(<chain>). Required for a chain to
# reach economic eligibility. One or comma-separated endpoints.
PROVIDER_RPC_URLS_BASE=
PROVIDER_RPC_URLS_ETHEREUM=
PROVIDER_RPC_URLS_ARBITRUM=
PROVIDER_RPC_URLS_OPTIMISM=
PROVIDER_RPC_URLS_POLYGON=
PROVIDER_RPC_URLS_BNB=

# --- DISCOVERY RPC (backs pool discovery / quoting; resolve_rpc_url_from_env) ---
# Consumed by rpc_explicitly_configured(<chain>) and the per-chain sync resolver.
ARBICORE_RPC_URL_BASE=
ARBICORE_RPC_URL_ETHEREUM=
ARBICORE_RPC_URL_ARBITRUM=
ARBICORE_RPC_URL_OPTIMISM=
ARBICORE_RPC_URL_POLYGON=
ARBICORE_RPC_URL_BNB=

# --- BASE-only legacy aliases (kept for the existing Base flow; DO NOT reuse
#     for other chains — they will not and must not resolve cross-chain) ---
# ARBICORE_RPC_URL=            # base-only global alias (optional)
# ARBICORE_ARCHIVE_RPC_URL=    # base archive node (optional)
