# =============================================================================
#  ArbiCore X — .env.shared.example  (Shared-Infrastructure Profile)
# =============================================================================
#
#  Purpose: shared-profile wiring ONLY. Values in this file describe HOW
#           ArbiCore X plugs into an existing peer stack (network name, Mongo
#           host, port assignments, container names, image tags). Application
#           secrets and scanner toggles live in the repo-root `.env`
#           (copied from `.env.production.example`).
#
#           `.env` and `.env.shared` are BOTH consumed by
#           docker-compose.shared.yml — the compose file's `env_file:` clause
#           reads `.env` (app), and `--env-file .env.shared` on the command
#           line supplies compose-time substitutions.
#
#  Usage:
#    cd $REPO_ROOT/deployment/compose/
#    cp .env.shared.example .env.shared
#    $EDITOR .env.shared
#    chmod 600 .env.shared
#    docker compose --env-file .env.shared -f docker-compose.shared.yml up -d
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. NETWORK  (external — owned by peer stack)
# -----------------------------------------------------------------------------

# REQUIRED  Name of the pre-existing Docker network that the peer stack (e.g.
#           Strategy Factory) created. ArbiCore X attaches to it as an
#           external network. Confirm with:  docker network ls
NETWORK_NAME=vqb-network

# -----------------------------------------------------------------------------
# 1b. FRONTEND BUILD URL  (baked into the JS bundle at BUILD time)
# -----------------------------------------------------------------------------
#
# REQUIRED  Public URL where the operator UI and Opportunity Center will be
#           reachable by end-user browsers. This is the origin that the
#           SPA's JS bundle will call for /api/* requests.
#
#           CRA (operator UI) and Vite (Opportunity Center) both bake this
#           variable INTO THE JS BUNDLE AT BUILD TIME — it is NOT read from
#           the environment at runtime. Changing it after the image is built
#           has no effect; you must rebuild.
#
#           If left empty, docker-compose.shared.yml will refuse to build
#           with an explicit error (fail-fast guard).
#
#           Examples:
#             REACT_APP_BACKEND_URL=https://arbicore.example.com
#             REACT_APP_BACKEND_URL=https://ops.mycompany.io
#
#           The same value is reused as VITE_BACKEND_URL for the Opportunity
#           Center — operators only set this once.
REACT_APP_BACKEND_URL=

# -----------------------------------------------------------------------------
# 2. EXTERNAL MONGODB  (owned by peer stack)
# -----------------------------------------------------------------------------

# REQUIRED  Container hostname of the peer stack's Mongo container as seen
#           from within the shared network. Confirm with:
#             docker network inspect $NETWORK_NAME | grep -A1 mongo
MONGO_HOST=factory-mongo

# OPTIONAL  Mongo listening port inside the container. Default 27017.
MONGO_PORT=27017

# REQUIRED IF PEER MONGO HAS AUTH ENABLED
#           Fully-formed Mongo URL. If set, this OVERRIDES the composition of
#           MONGO_HOST + MONGO_PORT above. Peer installations (e.g. Strategy
#           Factory) commonly enable Mongo auth; in that case setting a bare
#           MONGO_HOST/MONGO_PORT will cause the ArbiCore X backend to fail at
#           first Mongo write with:
#             pymongo.errors.OperationFailure: Command createIndexes requires authentication
#           Bake credentials into MONGO_URL:
#             MONGO_URL=mongodb://arbicore:s3cr3t@factory-mongo:27017/?authSource=admin
#           Leave blank ONLY if the peer Mongo has NO auth (rare in production).
MONGO_URL=

# REQUIRED  Database name to isolate ArbiCore X data within the shared Mongo
#           instance. Must be a name NOT used by the peer stack — confirm with:
#             docker exec factory-mongo mongosh --quiet --eval 'db.adminCommand({listDatabases:1}).databases.map(d=>d.name)'
DB_NAME=arbicore_x

# -----------------------------------------------------------------------------
# 3. HOST PORT MAPPING  (loopback-only by default)
# -----------------------------------------------------------------------------
#
# The peer stack's Caddy (or nginx) reverse-proxies to these ports on the
# host. Change them only if they collide with other services on the VPS.
#

# Backend API port on the host (Caddy proxies /api/* to this).
BACKEND_HOST_PORT=8101
BACKEND_HOST_BIND=127.0.0.1

# Operator UI port on the host (Caddy proxies / to this).
FRONTEND_HOST_PORT=8102
FRONTEND_HOST_BIND=127.0.0.1

# Analytics UI (Opportunity Center) port on the host (Caddy proxies
# /opportunity-center/* to this).
OPPORTUNITY_CENTER_HOST_PORT=8103
OPPORTUNITY_CENTER_HOST_BIND=127.0.0.1

# -----------------------------------------------------------------------------
# 4. CONTAINER NAMES  (must be unique on the host)
# -----------------------------------------------------------------------------
#
# If you're running multiple ArbiCore X instances on the same VPS (staging +
# prod, or tenant-A + tenant-B), prefix these to avoid Docker name collisions.
#

BACKEND_CONTAINER_NAME=arbicore-x-backend
FRONTEND_CONTAINER_NAME=arbicore-x-frontend
OPPORTUNITY_CENTER_CONTAINER_NAME=arbicore-x-opportunity-center

# Network aliases (how peer containers address this stack over the shared net).
# Same convention: prefix per tenant to avoid alias collisions.
BACKEND_NETWORK_ALIAS=arbicore-backend
FRONTEND_NETWORK_ALIAS=arbicore-frontend
OPPORTUNITY_CENTER_NETWORK_ALIAS=arbicore-opportunity-center

# -----------------------------------------------------------------------------
# 5. IMAGE TAGS  (built locally, or pulled from a registry)
# -----------------------------------------------------------------------------
#
# As of v1.0.2, docker-compose.shared.yml carries `build:` blocks for the
# frontend and opportunity_center services, so you can build them in-place
# with the correct REACT_APP_BACKEND_URL baked in:
#
#     cd $REPO_ROOT/deployment/compose
#     docker compose --env-file .env.shared -f docker-compose.shared.yml \
#         build --no-cache frontend opportunity_center
#
# Alternatively, pull pre-built images from a registry:
#     FRONTEND_IMAGE_TAG=registry.example.com/arbicore-x-frontend:1.0.2
#
# The backend image has no build-time env dependencies and can be built
# either from the greenfield compose or pulled from a registry.
#

BACKEND_IMAGE_TAG=arbicore-x-backend:1.0.2
FRONTEND_IMAGE_TAG=arbicore-x-frontend:1.0.2
OPPORTUNITY_CENTER_IMAGE_TAG=arbicore-x-opportunity-center:1.0.2

# Provenance label baked into the container. Set to the git SHA of the source
# commit that produced the images. Populated automatically by the build tool
# in greenfield mode; set here explicitly in shared mode.
GITSHA=unknown

# -----------------------------------------------------------------------------
# 6. LOG STORAGE
# -----------------------------------------------------------------------------

# Docker named volume backing /var/log/arbicore-x inside the backend. Prefix
# per tenant if you're running multiple instances.
LOGS_VOLUME_NAME=arbicore-x-shared-logs

# -----------------------------------------------------------------------------
# 7. RESOURCE LIMITS  (optional — tune if the VPS is memory-constrained)
# -----------------------------------------------------------------------------

BACKEND_CPU_LIMIT=2.0
BACKEND_MEM_LIMIT=2G
BACKEND_CPU_RESERVE=0.5
BACKEND_MEM_RESERVE=512M

FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=256M

OPPORTUNITY_CENTER_CPU_LIMIT=0.5
OPPORTUNITY_CENTER_MEM_LIMIT=256M

# -----------------------------------------------------------------------------
# 8. CADDY LABEL-BASED ROUTING  (optional — only for caddy-docker-proxy)
# -----------------------------------------------------------------------------
#
# If the peer stack's Caddy runs the caddy-docker-proxy plugin (routing by
# labels rather than config file), set these to the FQDNs Caddy should serve
# each service on. Leave BLANK to disable label-based routing (safe default;
# operator manages Caddy config manually).
#
# Example (Caddy plugin enabled, single-domain layout):
#   CADDY_BACKEND_HOST=arbicore.example.com
#   CADDY_FRONTEND_HOST=arbicore.example.com
#   CADDY_OPPORTUNITY_CENTER_HOST=arbicore.example.com/opportunity-center/*
#

CADDY_BACKEND_HOST=
CADDY_FRONTEND_HOST=
CADDY_OPPORTUNITY_CENTER_HOST=

# =============================================================================
#  END .env.shared.example
# =============================================================================
