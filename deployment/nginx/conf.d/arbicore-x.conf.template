# Domain-templated site config for ArbiCore X.
# `envsubst '$DOMAIN' <this> >/etc/nginx/conf.d/arbicore-x.conf` at container boot.
#
# Routes:
#   /                            → operator terminal UI (frontend)
#   /opportunity-center/         → analytics UI (opportunity_center)
#   /api/                        → backend :8001 (FastAPI)
#   /ws                          → backend WebSocket upgrade (if used)
#   /.well-known/acme-challenge/ → certbot HTTP-01 challenge
#   /nginx-health                → nginx healthcheck (internal only)

# ------- upstreams -------
upstream backend_upstream {
    server backend:8001;
    keepalive 32;
}

upstream frontend_upstream {
    server frontend:80;
    keepalive 16;
}

upstream oc_upstream {
    server opportunity_center:80;
    keepalive 16;
}

# ------- rate limits (defense-in-depth) -------
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/m;

# ------- 80: ACME + HTTPS redirect -------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${DOMAIN};

    # Certbot HTTP-01 challenge.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    # Local nginx healthcheck (used by compose).
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Everything else → HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------- 443: TLS -------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    # TLS + security headers (loaded from snippets).
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/security_headers.conf;
    include /etc/nginx/snippets/gzip.conf;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;

    client_max_body_size 25m;

    # -------- API --------
    location /api/ {
        limit_req zone=api_limit burst=40 nodelay;

        proxy_pass         http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
    }

    # Login endpoint gets its own tighter throttle.
    location = /api/auth/login {
        limit_req zone=login_limit burst=10 nodelay;

        proxy_pass         http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # -------- WebSocket upgrade (if the backend adds /ws in future) --------
    location /ws {
        proxy_pass         http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;   # long-lived streams
    }

    # -------- Opportunity Center (secondary UI) --------
    location /opportunity-center/ {
        proxy_pass         http://oc_upstream/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # -------- Operator terminal UI (default) --------
    location / {
        proxy_pass         http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
