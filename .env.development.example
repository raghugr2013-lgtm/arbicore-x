# =============================================================================
#  ArbiCore X VPS Bundle — .env.development.example  (DEV-PERMISSIVE)
# =============================================================================
#
#  Purpose: permissive defaults for a local single-host dev environment where
#           you serve the stack from localhost, don't have a real domain, and
#           want verbose logging.
#
#  NOT FOR PRODUCTION. Use .env.production.example on any public host.
#
#  Differences from .env.production.example:
#    - DOMAIN=localhost                (no real DNS)
#    - LETSENCRYPT_MODE=staging        (never call prod ACME from dev)
#    - LOG_LEVEL=DEBUG                 (verbose)
#    - CORS_ORIGINS=*                  (permissive; NEVER prod)
#    - DB_NAME=arbicore_dev
#    - BACKUP_RETENTION_DAYS=7         (short — dev is disposable)
#    - Sample dev-safe admin creds     (change if you fear localhost snooping)
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DEPLOYMENT IDENTITY
# -----------------------------------------------------------------------------
DOMAIN=localhost
BACKEND_IMAGE_TAG=arbicore-x-backend:0.1.0
FRONTEND_IMAGE_TAG=arbicore-x-frontend:0.1.0
OPPORTUNITY_CENTER_IMAGE_TAG=arbicore-x-opportunity-center:0.1.0
MONGO_IMAGE=mongo:4.4
GITSHA=dev

# -----------------------------------------------------------------------------
# 2. TLS / LET'S ENCRYPT  (staging-only in dev)
# -----------------------------------------------------------------------------
LETSENCRYPT_EMAIL=dev@localhost.invalid
LETSENCRYPT_MODE=staging

# -----------------------------------------------------------------------------
# 3. APPLICATION SECURITY  (dev-only; still change if paranoid)
# -----------------------------------------------------------------------------
# Placeholder secrets — 32 bytes of "a", clearly not random. Replace before
# using this .env on any host other than a personal dev laptop.
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VAULT_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ARBICORE_ADMIN_USER=admin
ARBICORE_ADMIN_PASS=devadmin1234

ARBICORE_QUOTE_CAPTURE_KEY=dev-quote-capture-key-not-a-real-secret

REACT_APP_BACKEND_URL=http://localhost:8001
ARBICORE_BASE_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# 4. MONGO / DATA LAYER
# -----------------------------------------------------------------------------
MONGO_URL=mongodb://mongo:27017
DB_NAME=arbicore_dev

# -----------------------------------------------------------------------------
# 5. CORS / LOGGING  (permissive)
# -----------------------------------------------------------------------------
CORS_ORIGINS=*
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# 6. BACKUPS  (short retention; dev is disposable)
# -----------------------------------------------------------------------------
BACKUP_DIR=/tmp/arbicore-x-dev-backups
BACKUP_RETENTION_DAYS=7
BACKUP_RCLONE_REMOTE=

# -----------------------------------------------------------------------------
# 7. SCANNERS  (leave dormant unless you're actively testing one)
# -----------------------------------------------------------------------------
ARBICORE_SCANNER_CEX_ARB=false
ARBICORE_SCANNER_DEX_ARB=false
ARBICORE_SCANNER_FUNDING_ARB=false
ARBICORE_SCANNER_LAUNCH_ARB=false

# Dev-only debug helpers (still "false" by default; flip only when needed).
ARBICORE_FORCE_PRIMARY_DOWN=false
ARBICORE_OBSERVER_DISABLE=false

# -----------------------------------------------------------------------------
# 8. THIRD-PARTY DATA-SOURCE API KEYS  (usually free-tier keys in dev)
# -----------------------------------------------------------------------------
ALCHEMY_API_KEY=
HELIUS_API_KEY=
BITQUERY_API_KEY=
GRAPH_GATEWAY_API_KEY=

# -----------------------------------------------------------------------------
# 9. LI.FI PROBE ADDRESSES
# -----------------------------------------------------------------------------
LIFI_PROBE_FROM_ADDRESS_EVM=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
LIFI_PROBE_FROM_ADDRESS_SOLANA=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# =============================================================================
#  END .env.development.example
# =============================================================================
