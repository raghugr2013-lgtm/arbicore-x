# ArbiCore X — Executor Deployment Environment (example)
# Copy to `.env`, populate with real values, and NEVER commit `.env`.
# --------------------------------------------------------------------------

# --- Network endpoints ---------------------------------------------------
# Base mainnet — chain id 8453
BASE_RPC_URL=https://mainnet.base.org
# Base Sepolia testnet — chain id 84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Explorer verification ----------------------------------------------
# One key works for both base + base_sepolia (Etherscan v2 multichain key).
BASESCAN_API_KEY=

# --- Deployer signing key (0x-prefixed 32-byte hex) ---------------------
# NEVER commit a real key. Use `cast wallet import` or a hardware wallet
# in production. This env slot is read by `forge script --private-key`.
DEPLOYER_PRIVATE_KEY=

# --- Runtime venue addresses (Base mainnet defaults; override for other) --
BASE_BALANCER_V2_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8
BASE_AAVE_V3_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
BASE_UNIV3_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481

# --- Base Sepolia venue addresses (fill when running against testnet) ----
# Balancer V2 Vault is the same address on every chain it supports.
BASE_SEPOLIA_BALANCER_V2_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8
# Aave V3 Pool on Base Sepolia — verify against
# https://aave.com/docs/resources/addresses before use.
BASE_SEPOLIA_AAVE_V3_POOL=
# Uniswap V3 SwapRouter02 on Base Sepolia — verify before use.
BASE_SEPOLIA_UNIV3_ROUTER=

# --- Canonical config sync ----------------------------------------------
# After a successful deployment, `script/Deploy.s.sol` prints the address
# so it can be fed into the ArbiCore X backend via:
#     ARBICORE_EXECUTOR_ADDRESS_BASE=0x...   (backend/.env)
ARBICORE_EXECUTOR_ADDRESS_BASE=
ARBICORE_EXECUTOR_ADDRESS_BASE_SEPOLIA=
