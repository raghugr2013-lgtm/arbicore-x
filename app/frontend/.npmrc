# =============================================================================
#  ArbiCore X — Frontend npm configuration
#
#  Purpose: tolerate the peer-dependency mismatch between:
#    react-day-picker@8.10.1  (peer requires  date-fns ^2.28.0 || ^3.0.0)
#    date-fns@4.1.0           (installed direct dep at v4)
#
#  Yarn 1 (the declared packageManager for this project) treats peer-dep
#  mismatches as warnings and installs anyway; npm >= 7 treats them as
#  ERESOLVE errors by default. This file gives npm the same tolerance yarn
#  already has, so Docker builds that fall through to the npm code path
#  in the greenfield frontend Dockerfile do not fail.
#
#  Reproducibility is NOT sacrificed: the canonical dependency tree is
#  frozen in `yarn.lock` at the same directory. `.npmrc` only affects
#  npm's peer-resolution strategy, not which versions get installed
#  (the lockfile determines that).
#
#  Do not set additional flags here without discussion; this file is
#  intentionally minimal.
# =============================================================================

legacy-peer-deps=true
