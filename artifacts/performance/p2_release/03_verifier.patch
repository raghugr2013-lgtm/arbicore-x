+        timing: Optional[Dict[str, Any]],
+        stage: str,
+        t0: Optional[float],
+    ) -> None:
+        """Set stage_ms[stage] to measured ms, or leave null if unmeasured."""
+        try:
+            if timing is None or t0 is None:
