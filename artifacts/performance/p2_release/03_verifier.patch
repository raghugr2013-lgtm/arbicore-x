+    def _note_timing_error(
+        self,
+        timing: Optional[Dict[str, Any]],
+        stage: str,
+        exc: BaseException,
+    ) -> None:
+        """Record a short safe timing_error, or fall back to a warning log."""
+        try:
+            if timing is not None and not timing.get("timing_error"):
+                timing["timing_error"] = (
+                    f"{type(exc).__name__}:{stage}"
+                )[:120]
+                return
+        except Exception:  # noqa: BLE001 — nested fail-safe
+            pass
+        try:
+            _LOG.warning(
+                "timing_instrumentation_failed exception_type=%s stage=%s",
+                type(exc).__name__,
+                stage,
+            )
+        except Exception:  # noqa: BLE001
+            pass
