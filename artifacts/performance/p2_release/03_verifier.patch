+# Evidence-sink fire-and-forget contract (composition ``make_flash_loan_evidence_sink``):
+# raises on persistence failure; returns ``None`` on success. ``None`` therefore
+# means confirmed success ONLY under that contract (Rev 2); ambiguous returns
+# resolve to ``null`` and are never silently coerced to success.
+_SINK_SUCCESS_TOKENS = frozenset({"ok", "success", "persisted", "true"})
+_SINK_FAILURE_TOKENS = frozenset({"fail", "failed", "error", "false"})
+
+
+def _resolve_sink_persist_result(result: Any) -> Optional[bool]:
+    """Map an evidence-sink return value to ``evidence_persisted``.
+
+    ``True``  — confirmed persistence success
+    ``False`` — confirmed persistence failure
+    ``None``  — genuinely unknown / ambiguous (never treated as success)
+    """
+    if result is None:
+        return True
+    if result is True:
+        return True
+    if result is False:
+        return False
+    if isinstance(result, str):
+        token = result.strip().lower()
+        if token in _SINK_SUCCESS_TOKENS:
+            return True
+        if token in _SINK_FAILURE_TOKENS:
+            return False
+        return None
+    if isinstance(result, dict):
+        if "ok" in result:
+            ok = result.get("ok")
+            if ok is True:
+                return True
+            if ok is False:
+                return False
+            return None
+        if "persisted" in result:
+            persisted = result.get("persisted")
+            if persisted is True:
+                return True
+            if persisted is False:
+                return False
+            return None
+        return None
+    return None
+
