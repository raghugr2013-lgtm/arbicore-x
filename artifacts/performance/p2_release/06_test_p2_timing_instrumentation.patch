--- /dev/null
+++ b/app/backend/tests/test_p2_flashloan_timing_instrumentation.py
@@ -0,0 +1,324 @@
+"""P2 instrumentation: durable claimed_at + fail-safe stage timings.
+
+Observability only. Never alters verifier verdicts, gate/risk decisions, or
+candidate-processing outcomes. Offline / deterministic where possible.
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+from unittest.mock import AsyncMock, MagicMock
+
+from arbicore.data.discovery_queue import DiscoveryQueue
+from arbicore.discovery import base_pool_registry as reg
+from arbicore.intelligence.roi_probability import ROIProbabilityEngine
+from arbicore.models.discovery import DiscoveryCandidate, VerifiedOutcome
+from arbicore.models.enums import OpportunityType
+from arbicore.scanners.cross_chain_arbitrage.bridge_intelligence import (
+    MevRiskScorer,
+)
+from arbicore.scanners.flash_loan_arbitrage.economics import (
+    FlashLoanEconomicsAssessor,
+)
+from arbicore.scanners.flash_loan_arbitrage.filter import (
+    FlashLoanGate7AtomicProfit, FlashLoanGate8LiquidityDepth,
+    FlashLoanGate9FlashLoanMev,
+)
+from arbicore.scanners.flash_loan_arbitrage.verifier import (
+    FlashLoanOpportunityVerifier,
+    _resolve_sink_persist_result,
+)
+
+
+def _run(coro):
+    return asyncio.new_event_loop().run_until_complete(coro)
+
+
+def _real_pool_ids():
+    ids = [p.canonical_id for p in reg.get_canonical_pools()
+           if p.address_resolution == reg.DETERMINISTIC_VERIFIED
+           and p.dex == "uniswap_v3"
+           and {"WETH", "USDC"} == {p.token0_symbol, p.token1_symbol}]
+    return ids[:2]
+
+
+def _hm():
+    return {"chain": "base", "provider": "balancer_v2", "borrow_token": "WETH",
+            "borrow_amount_usd": 10_000.0, "route_pools": _real_pool_ids(),
+            "cycle_token_path": ["WETH", "USDC", "WETH"],
+            "route_dex_protocols": ["uniswap_v3", "uniswap_v3"], "hop_count": 2}
+
+
+def _facts(gross_pct=3.0):
+    leg = {"venue_id": "uniswap_v3:base", "source_id": "uniswap_v3_quoter_base",
+           "fee_bps": 5, "depth_usd": 500_000.0, "dex_protocol": "uniswap_v3"}
+    return {"hop_legs": [dict(leg), dict(leg)], "gross_profit_pct": gross_pct,
+            "tx_gas_units": 250_000, "min_pool_tvl_usd_in_route": 500_000.0,
+            "tvl_provenance": "onchain_reserves", "route_quote_status": "ok",
+            "verified_at_ts": 123.0, "quote_block": 999}
+
+
+def _mk_verifier(*, gross_pct=3.0, quote_provider=None, evidence_sink=None):
+    async def _qp(hm, borrow):
+        return _facts(gross_pct)
+
+    return FlashLoanOpportunityVerifier(
+        quote_provider=quote_provider or _qp,
+        economics_assessor=FlashLoanEconomicsAssessor(
+            roi_engine=ROIProbabilityEngine(min_sample=8, winsorize_pct=0.05),
+            default_borrow_amount_usd=10_000.0),
+        mev_scorer=MevRiskScorer(),
+        gate_7=FlashLoanGate7AtomicProfit({}),
+        gate_8=FlashLoanGate8LiquidityDepth({}),
+        gate_9=FlashLoanGate9FlashLoanMev({}),
+        default_borrow_amount_usd=10_000.0,
+        evidence_sink=evidence_sink,
+    )
+
+
+def _candidate(**overrides):
+    data = dict(
+        candidate_id="cand-p2",
+        hint_source="test_source",
+        opportunity_type=OpportunityType.FLASH_LOAN_ARBITRAGE,
+        subject_id="WETH-USDC",
+        asset="WETH",
+        hint_metric=_hm(),
+        hint_observed_at=1000.0,
+        claimed_at=1010.0,
+        claimed_by="worker-p2",
+    )
+    data.update(overrides)
+    return DiscoveryCandidate(**data)
+
+
+def _verify_capture(v, cand=None):
+    captured = []
+
+    async def sink(b):
+        captured.append(b)
+        return None
+
+    v.evidence_sink = sink
+    opp, outcome = _run(v.verify(cand or _candidate()))
+    return opp, outcome, captured[0] if captured else None
+
+
+# ---- sink persist resolution (unit) ---------------------------------------
+
+def test_resolve_sink_none_is_success_under_fire_and_forget_contract():
+    assert _resolve_sink_persist_result(None) is True
+
+
+def test_resolve_sink_explicit_bool_and_ambiguous():
+    assert _resolve_sink_persist_result(True) is True
+    assert _resolve_sink_persist_result(False) is False
+    assert _resolve_sink_persist_result({"weird": 1}) is None
+    assert _resolve_sink_persist_result(123) is None
+
+
+# ---- durable claimed_at ---------------------------------------------------
+
+def test_mark_processed_keeps_claimed_at_clears_lock_fields():
+    q = DiscoveryQueue.__new__(DiscoveryQueue)
+    q._col = MagicMock()
+    q._col.update_one = AsyncMock(
+        return_value=MagicMock(modified_count=1))
+    ok = _run(q.mark_processed(
+        "cand-1", "confirmed_canonical:x", observed_at=1.0))
+    assert ok is True
+    update = q._col.update_one.await_args.args[1]["$set"]
+    assert "claimed_at" not in update
+    assert update["claimed_by"] is None
+    assert update["claimed_until"] is None
+    assert update["verified_outcome"] == "confirmed_canonical:x"
+
+
+# ---- timing semantics -----------------------------------------------------
+
+def test_controlled_clock_timestamp_ordering():
+    clock = {"t": 2000.0}
+
+    def _now():
+        clock["t"] += 1.0
+        return clock["t"]
+
+    v = _mk_verifier()
+    v._now = _now
+    _opp, outcome, b = _verify_capture(v)
+    assert outcome.startswith(VerifiedOutcome.CONFIRMED_PREFIX)
+    timing = b["diagnostics"]["timing"]
+    assert timing["hint_observed_at"] == 1000.0
+    assert timing["claimed_at"] == 1010.0
+    assert timing["hint_observed_at"] <= timing["claimed_at"]
+    assert timing["claimed_at"] <= timing["verify_started_at"]
+    assert timing["verify_started_at"] <= timing["decided_at"]
+    for stage in ("quote", "economics", "gates", "finalize"):
+        assert isinstance(timing["stage_ms"][stage], int)
+        assert timing["stage_ms"][stage] >= 0
+
+
+def test_missing_stages_remain_null_on_early_deny():
+    async def _no_quote(hm, borrow):
+        return None
+
+    v = _mk_verifier(quote_provider=_no_quote)
+    _opp, outcome, b = _verify_capture(v)
+    assert outcome == VerifiedOutcome.DENIED_VENUE_UNREADABLE
+    timing = b["diagnostics"]["timing"]
+    assert isinstance(timing["stage_ms"]["quote"], int)
+    assert timing["stage_ms"]["economics"] is None
+    assert timing["stage_ms"]["gates"] is None
+    assert isinstance(timing["stage_ms"]["finalize"], int)
+
+
+def test_genuine_zero_duration_allowed_when_stage_ran():
+    v = _mk_verifier()
+    v._now = lambda: 5000.0
+    _opp, outcome, b = _verify_capture(v)
+    assert outcome.startswith(VerifiedOutcome.CONFIRMED_PREFIX)
+    timing = b["diagnostics"]["timing"]
+    assert timing["stage_ms"]["quote"] == 0
+    assert timing["stage_ms"]["economics"] == 0
+    assert timing["stage_ms"]["gates"] == 0
+    assert timing["stage_ms"]["finalize"] == 0
+
+
+def test_inconsistent_timestamps_not_invented():
+    v = _mk_verifier()
+    cand = _candidate(hint_observed_at=2000.0, claimed_at=1000.0)
+    _opp, outcome, b = _verify_capture(v, cand)
+    assert outcome.startswith(VerifiedOutcome.CONFIRMED_PREFIX)
+    timing = b["diagnostics"]["timing"]
+    assert timing["hint_observed_at"] == 2000.0
+    assert timing["claimed_at"] == 1000.0
+    assert timing["timing_error"] == (
+        "inconsistent_timestamps:claimed_at<hint_observed_at")
+
+
+def test_missing_claimed_at_stays_null():
+    v = _mk_verifier()
+    cand = _candidate(claimed_at=None)
+    assert cand.claimed_at is None
+    _opp, _outcome, b = _verify_capture(v, cand)
+    assert b["diagnostics"]["timing"]["claimed_at"] is None
+
+
+# ---- evidence_persisted ternary -------------------------------------------
+
+def test_evidence_persisted_null_when_sink_unwired():
+    v = _mk_verifier(evidence_sink=None)
+    bundles = []
+    orig = v._build_evidence_bundle
+
+    def _wrap(*a, **k):
+        b = orig(*a, **k)
+        bundles.append(b)
+        return b
+
+    v._build_evidence_bundle = _wrap  # type: ignore[method-assign]
+    opp, outcome = _run(v.verify(_candidate()))
+    assert opp is not None
+    assert outcome.startswith(VerifiedOutcome.CONFIRMED_PREFIX)
+    assert bundles
+    assert bundles[-1]["diagnostics"]["timing"]["evidence_persisted"] is None
+
+
+def test_evidence_persisted_true_on_none_return_fire_and_forget():
+    """Existing sink contract: return None after successful await = success."""
+    captured = []
+
+    async def sink(b):
+        captured.append(b)
+        return None
+
+    v = _mk_verifier(evidence_sink=sink)
+    opp, outcome = _run(v.verify(_candidate()))
+    assert opp is not None
+    assert outcome.startswith(VerifiedOutcome.CONFIRMED_PREFIX)
+    assert captured[-1]["diagnostics"]["timing"]["evidence_persisted"] is True
+
+
+def test_evidence_persisted_false_on_sink_raise():
+    async def boom(_b):
+        raise RuntimeError("mongo down")
+
+    v = _mk_verifier(evidence_sink=boom)
+    bundles = []
+    orig = v._build_evidence_bundle
+
+    def _wrap(*a, **k):
+        b = orig(*a, **k)
+        bundles.append(b)
+        return b
+
+    v._build_evidence_bundle = _wrap  # type: ignore[method-assign]
+    opp, outcome = _run(v.verify(_candidate()))
+    assert opp is not None
+    assert outcome.startswith(VerifiedOutcome.CONFIRMED_PREFIX)
+    assert bundles[-1]["diagnostics"]["timing"]["evidence_persisted"] is False
+
+
+def test_evidence_persisted_null_on_ambiguous_return():
+    captured = []
+
+    async def sink(b):
+        captured.append(b)
+        return {"unexpected": "shape"}
+
+    v = _mk_verifier(evidence_sink=sink)
+    opp, outcome = _run(v.verify(_candidate()))
+    assert opp is not None
+    assert outcome.startswith(VerifiedOutcome.CONFIRMED_PREFIX)
+    assert captured[-1]["diagnostics"]["timing"]["evidence_persisted"] is None
+
+
+def test_evidence_persisted_false_on_explicit_false_return():
+    captured = []
+
+    async def sink(b):
+        captured.append(b)
+        return False
+
+    v = _mk_verifier(evidence_sink=sink)
+    opp, outcome = _run(v.verify(_candidate()))
+    assert opp is not None
+    assert outcome.startswith(VerifiedOutcome.CONFIRMED_PREFIX)
+    assert captured[-1]["diagnostics"]["timing"]["evidence_persisted"] is False
+
+
+# ---- fail-safe instrumentation --------------------------------------------
+
+def test_instrumentation_failure_does_not_change_verdict():
+    v = _mk_verifier()
+    v._now = lambda: (_ for _ in ()).throw(RuntimeError("clock exploded"))
+    opp, outcome, b = _verify_capture(v)
+    assert opp is not None
+    assert outcome.startswith(VerifiedOutcome.CONFIRMED_PREFIX)
+    timing = b["diagnostics"]["timing"]
+    assert timing["stage_ms"]["quote"] is None
+    assert timing["evidence_persisted"] is True
+
+
+def test_timing_error_secondary_failure_emits_safe_warning(caplog):
+    v = _mk_verifier()
+
+    class _BadTiming(dict):
+        def get(self, *a, **k):
+            return None
+
+        def __setitem__(self, key, value):
+            raise RuntimeError("cannot record timing_error")
+
+    with caplog.at_level(logging.WARNING):
+        v._note_timing_error(_BadTiming(), "quote", RuntimeError("clock down"))
+
+    assert any(
+        "timing_instrumentation_failed" in r.message for r in caplog.records
+    )
+    for r in caplog.records:
+        if "timing_instrumentation_failed" in r.message:
+            assert "hop_legs" not in r.message
+            assert "calldata" not in r.message
+            assert "exception_type=RuntimeError" in r.message
+            assert "stage=quote" in r.message
