# =============================================================================
#  ArbiCore X VPS Bundle — .env.example  (CANONICAL TEMPLATE)
# =============================================================================
#
#  Purpose: canonical environment contract for the deployment bundle.
#           Copy this file to `.env` at $BUNDLE_ROOT (the same directory as
#           this template) and edit values before running scripts/install.sh.
#
#  Two sibling templates provide deployment-specific defaults:
#    - .env.production.example  → hardened production defaults (LETSENCRYPT_MODE=prod,
#                                 LOG_LEVEL=WARNING, CORS scoped, 30 d retention)
#    - .env.development.example → permissive local defaults (DOMAIN=localhost,
#                                 LETSENCRYPT_MODE=staging, LOG_LEVEL=DEBUG)
#
#  Security rules for the final `.env`:
#    - chmod 600 .env
#    - Never commit .env to git (this bundle's .gitignore already excludes it).
#    - Rotate JWT_SECRET, VAULT_KEY, and MONGO_INITDB_ROOT_PASSWORD if they leak.
#
#  Naming convention: `# REQUIRED` = must be set for the stack to start.
#                     `# OPTIONAL` = has a documented default; leave blank to use it.
#                     `# TOGGLE`   = boolean flag; "true" or "1" enables.
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DEPLOYMENT IDENTITY
# -----------------------------------------------------------------------------

# REQUIRED  Fully-qualified domain name the operator UI is served under.
#           Must resolve (A / AAAA) to this VPS's public IP. Used by nginx
#           (envsubst-rendered at container boot) and by init-letsencrypt.sh.
#           Do NOT include a scheme or trailing slash.
DOMAIN=arbicore.example.com

# OPTIONAL  Docker image tag override for the backend service. Change ONLY when
#           deploying a locally rebuilt image; the default matches the shipped bundle.
BACKEND_IMAGE_TAG=arbicore-x-backend:0.1.0

# OPTIONAL  Docker image tag override for the operator UI (frontend) service.
FRONTEND_IMAGE_TAG=arbicore-x-frontend:0.1.0

# OPTIONAL  Docker image tag override for the analytics UI.
OPPORTUNITY_CENTER_IMAGE_TAG=arbicore-x-opportunity-center:0.1.0

# OPTIONAL  MongoDB image (default "mongo:4.4" is the bundle-tested version).
#           Set to "mongo:6.0" or "mongo:7.0" only if you have run the schema
#           compatibility tests documented in docs/OPERATIONS.md.
MONGO_IMAGE=mongo:4.4

# OPTIONAL  Git SHA baked into image labels (`arbicore.gitsha`). Auto-populated
#           by scripts/install.sh; override only when hand-building images.
GITSHA=unknown

# -----------------------------------------------------------------------------
# 2. TLS / LET'S ENCRYPT
# -----------------------------------------------------------------------------

# REQUIRED  Email address for Let's Encrypt account + cert-expiry warnings.
#           Use a real inbox; expiry notices land here 20 d before expiration.
LETSENCRYPT_EMAIL=ops@example.com

# REQUIRED  Certificate issuance mode. Always start with "staging" on first
#           deploy to avoid Let's Encrypt rate limits (5 duplicate certs /
#           week / FQDN). Flip to "prod" only after the staging cert is issued
#           and the stack has been dry-run successfully.
#           Values: staging | prod
LETSENCRYPT_MODE=staging

# -----------------------------------------------------------------------------
# 3. APPLICATION SECURITY (BACKEND)
# -----------------------------------------------------------------------------

# REQUIRED  JWT signing secret for the operator-auth cookie. Must be at least
#           32 random bytes. Generate with:  openssl rand -hex 32
#           Rotating this invalidates every existing operator session.
JWT_SECRET=change-me-jwt-secret-32-plus-random-bytes

# REQUIRED  Symmetric key used by the vault module to encrypt sensitive fields
#           (API keys, capture payloads) at rest. Generate with:
#             openssl rand -hex 32
#           Rotating this makes previously-encrypted rows unreadable.
VAULT_KEY=change-me-vault-key-32-plus-random-bytes

# REQUIRED  Bootstrap operator admin username (seeded on first backend start).
#           Change immediately after first login via the operator UI.
ARBICORE_ADMIN_USER=admin

# REQUIRED  Bootstrap operator admin password (seeded on first backend start).
#           Change immediately after first login. Minimum 12 chars recommended.
ARBICORE_ADMIN_PASS=change-me-strong-admin-password

# OPTIONAL  API key that authenticates POSTs to /api/arbicore/quote-capture
#           (the userscript companion sends this in an X-Api-Key header).
#           Leave blank to disable the capture endpoint. Generate with:
#             openssl rand -hex 24
ARBICORE_QUOTE_CAPTURE_KEY=

# REQUIRED  Public backend URL baked into the operator-UI JS bundle at build
#           time. CRA/Vite replace `process.env.REACT_APP_*` at COMPILE time,
#           so an empty value produces a broken bundle (`undefined/api/...`,
#           black-screen operator UI). Both docker-compose files and the
#           frontend Dockerfile HARD-FAIL if this is empty. In production this
#           is normally `https://${DOMAIN}`.
REACT_APP_BACKEND_URL=https://arbicore.example.com

# OPTIONAL  Informational base URL the backend advertises to itself (used in
#           some log lines and health payloads). Usually the same as DOMAIN.
ARBICORE_BASE_URL=https://arbicore.example.com

# -----------------------------------------------------------------------------
# 4. MONGO / DATA LAYER
# -----------------------------------------------------------------------------

# REQUIRED  Mongo connection URI used by the backend to reach the mongo
#           container. For a single-host greenfield deploy this stays as the
#           default; do NOT change unless you have externalised Mongo.
MONGO_URL=mongodb://mongo:27017

# REQUIRED  Database name inside Mongo. Use "arbicore_prod" or a company-
#           specific name in production; the historical dev default is
#           "test_database" (do NOT ship prod with that name).
DB_NAME=arbicore_prod

# -----------------------------------------------------------------------------
# 5. CORS / LOGGING
# -----------------------------------------------------------------------------

# REQUIRED  Comma-separated list of origins allowed to call /api/*.
#           Production MUST be scoped to https://${DOMAIN}, no wildcards.
#           Development may use "*" (never in production).
CORS_ORIGINS=https://arbicore.example.com

# OPTIONAL  Backend log level.  DEBUG | INFO | WARNING | ERROR
#           Production default: WARNING. Development default: DEBUG.
LOG_LEVEL=WARNING

# -----------------------------------------------------------------------------
# 6. BACKUPS
# -----------------------------------------------------------------------------

# OPTIONAL  Filesystem path where mongodump snapshots are written by
#           infrastructure/backups/backup-cron.sh.  Default is
#           /var/backups/arbicore-x on the host.
BACKUP_DIR=/var/backups/arbicore-x

# OPTIONAL  Number of days to keep local backup files. Production default 30.
BACKUP_RETENTION_DAYS=14

# OPTIONAL  rclone remote spec for off-host backup replication (format:
#           "remote-name:bucket/path"). Leave blank to disable off-host push.
#           Requires rclone to be installed on the host (not in the container).
BACKUP_RCLONE_REMOTE=

# -----------------------------------------------------------------------------
# 7. SCANNER TOGGLES (dormant by default — operator-controlled)
# -----------------------------------------------------------------------------
#
# ArbiCore X ships with all scanners DORMANT. Each scanner is enabled with an
# explicit "true" (or "1") in the corresponding variable below. Scanners can
# also be toggled at runtime via /api/arbicore/scanner/state without editing
# .env; setting the value here defines the DEFAULT state on first boot.
#
# See memory/arbicore_x/PHASE_D_MASTER_PLAN.md for what each scanner does.
#

# TOGGLE   Enable CEX order-book arbitrage scanner on first boot.
ARBICORE_SCANNER_CEX_ARB=false

# TOGGLE   Enable DEX cross-venue arbitrage scanner on first boot.
ARBICORE_SCANNER_DEX_ARB=false

# TOGGLE   Enable funding-rate arbitrage scanner on first boot.
ARBICORE_SCANNER_FUNDING_ARB=false

# TOGGLE   Enable launch/newly-listed arbitrage scanner on first boot.
#          Requires labels.json to contain curated wallets AND a live
#          LaunchVenueProvider wired via scanner.set_venue_provider(...).
#          With the default _noop_venue_provider, every candidate is denied.
ARBICORE_SCANNER_LAUNCH_ARB=false

# TOGGLE   Debug flag — force the primary provider path to appear "down" so
#          the fallback path is exercised. NEVER set in production.
ARBICORE_FORCE_PRIMARY_DOWN=false

# TOGGLE   Disable the ShadowBindingObserver (legacy → canonical bridge).
#          Set to "true" only when explicitly directed by ops. NEVER in prod.
ARBICORE_OBSERVER_DISABLE=false

# -----------------------------------------------------------------------------
# 8. THIRD-PARTY DATA-SOURCE API KEYS
# -----------------------------------------------------------------------------
#
# All of the following are OPTIONAL. Missing keys degrade specific scanners
# but the stack still boots. See docs/OPERATIONS.md § "Data source keys" for
# where each provider is used and how to obtain a free-tier key.
#

# OPTIONAL  Alchemy — EVM RPC (used by DEX, launch, cross-chain flows).
#           https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# OPTIONAL  Helius — Solana RPC + token metadata (used by launch-arb scanner).
#           https://www.helius.dev
HELIUS_API_KEY=

# OPTIONAL  Bitquery — GraphQL cross-chain analytics (used as hint source).
#           https://bitquery.io
BITQUERY_API_KEY=

# OPTIONAL  The Graph gateway API key (used for hosted subgraph queries).
#           https://thegraph.com/studio/apikeys
GRAPH_GATEWAY_API_KEY=

# -----------------------------------------------------------------------------
# 9. LI.FI PROBE ADDRESSES (bridge-quote scanning)
# -----------------------------------------------------------------------------
#
# LI.FI bridge quoting needs a canonical "from" address per chain family so
# quotes are deterministic. These addresses are NEVER used for signing — they
# are read-only anchors for quote lookup. Use burner / well-known addresses.
#

# OPTIONAL  Canonical EVM "from" address used for LI.FI bridge quote probes.
#           Default (Vitalik Buterin's public address, arbitrary example).
LIFI_PROBE_FROM_ADDRESS_EVM=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045

# OPTIONAL  Canonical Solana "from" address used for LI.FI Solana probes.
#           Default (SPL Token Program, arbitrary well-known address).
LIFI_PROBE_FROM_ADDRESS_SOLANA=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# =============================================================================
#  END .env.example
# =============================================================================
