# =============================================================================
#  ArbiCore X VPS Bundle — .env.production.example  (PRODUCTION-LOCKED)
# =============================================================================
#
#  Purpose: production-hardened defaults. Copy to `.env`, then fill in the
#           REQUIRED values (DOMAIN, LETSENCRYPT_EMAIL, JWT_SECRET, VAULT_KEY,
#           admin credentials). Every other value is pre-set to a
#           production-safe posture.
#
#  Differences from .env.example:
#    - LETSENCRYPT_MODE=prod       (flip to "prod" only after staging succeeds)
#    - LOG_LEVEL=WARNING           (no debug leakage to logs)
#    - CORS_ORIGINS scoped         (no wildcards)
#    - DB_NAME=arbicore_prod       (never "test_database" in production)
#    - BACKUP_RETENTION_DAYS=30    (matches audit doc 13 policy)
#    - Debug flags forced off      (ARBICORE_FORCE_PRIMARY_DOWN,
#                                    ARBICORE_OBSERVER_DISABLE)
#    - Scanners remain DORMANT     (operator enables at runtime via UI)
#
#  After copying:  chmod 600 .env  and NEVER commit it.
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DEPLOYMENT IDENTITY  (REQUIRED — fill these in)
# -----------------------------------------------------------------------------
DOMAIN=REPLACE.WITH.YOUR.FQDN
BACKEND_IMAGE_TAG=arbicore-x-backend:0.1.0
FRONTEND_IMAGE_TAG=arbicore-x-frontend:0.1.0
OPPORTUNITY_CENTER_IMAGE_TAG=arbicore-x-opportunity-center:0.1.0
MONGO_IMAGE=mongo:4.4
GITSHA=unknown

# -----------------------------------------------------------------------------
# 2. TLS / LET'S ENCRYPT
# -----------------------------------------------------------------------------
# REQUIRED: a real ops inbox.
LETSENCRYPT_EMAIL=REPLACE_WITH_OPS_EMAIL

# PRODUCTION default is "prod". If this is your very first deploy, TEMPORARILY
# set to "staging", verify the staging cert is issued, then flip to "prod"
# and re-run scripts/install.sh (or the SSL renew path).
LETSENCRYPT_MODE=prod

# -----------------------------------------------------------------------------
# 3. APPLICATION SECURITY  (REQUIRED — generate with openssl rand -hex 32)
# -----------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
VAULT_KEY=REPLACE_WITH_openssl_rand_hex_32
ARBICORE_ADMIN_USER=admin
ARBICORE_ADMIN_PASS=REPLACE_WITH_STRONG_PASSWORD_MIN_16_CHARS

# OPTIONAL: leave blank to disable the userscript-companion capture endpoint.
ARBICORE_QUOTE_CAPTURE_KEY=

REACT_APP_BACKEND_URL=https://REPLACE.WITH.YOUR.FQDN
ARBICORE_BASE_URL=https://REPLACE.WITH.YOUR.FQDN

# -----------------------------------------------------------------------------
# 4. MONGO / DATA LAYER
# -----------------------------------------------------------------------------
MONGO_URL=mongodb://mongo:27017
DB_NAME=arbicore_prod

# -----------------------------------------------------------------------------
# 5. CORS / LOGGING  (production-locked)
# -----------------------------------------------------------------------------
# MUST be scoped in production. No wildcards.
CORS_ORIGINS=https://REPLACE.WITH.YOUR.FQDN
LOG_LEVEL=WARNING

# -----------------------------------------------------------------------------
# 6. BACKUPS  (30-day retention per audit doc 13)
# -----------------------------------------------------------------------------
BACKUP_DIR=/var/backups/arbicore-x
BACKUP_RETENTION_DAYS=30
# Strongly recommended in production: enable off-host replication.
BACKUP_RCLONE_REMOTE=

# -----------------------------------------------------------------------------
# 7. SCANNERS  (dormant — enable per-scanner at runtime via operator UI)
# -----------------------------------------------------------------------------
ARBICORE_SCANNER_CEX_ARB=false
ARBICORE_SCANNER_DEX_ARB=false
ARBICORE_SCANNER_FUNDING_ARB=false
ARBICORE_SCANNER_LAUNCH_ARB=false

# Debug flags MUST be off in production.
ARBICORE_FORCE_PRIMARY_DOWN=false
ARBICORE_OBSERVER_DISABLE=false

# -----------------------------------------------------------------------------
# 8. THIRD-PARTY DATA-SOURCE API KEYS  (fill only those you use)
# -----------------------------------------------------------------------------
ALCHEMY_API_KEY=
HELIUS_API_KEY=
BITQUERY_API_KEY=
GRAPH_GATEWAY_API_KEY=

# -----------------------------------------------------------------------------
# 9. LI.FI PROBE ADDRESSES  (read-only, never used for signing)
# -----------------------------------------------------------------------------
LIFI_PROBE_FROM_ADDRESS_EVM=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
LIFI_PROBE_FROM_ADDRESS_SOLANA=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# =============================================================================
#  END .env.production.example
# =============================================================================
